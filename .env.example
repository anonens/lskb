# Көшірмесін .env.local деп сақтаңыз (тек өз компьютеріңізде іске қосу үшін).
# Vercel-де бұл мәндер Settings → Environment Variables бөлімінде жазылады — README қараңыз.

# Міндетті емес: жаңа әкімші құпиясөзі. Бос қалса, сайт дайындалғанда таңдалған құпиясөз жұмыс істейді.
ADMIN_PASSWORD=

# Міндетті емес: сессия кілті (кемі 16 таңба). Бос болса, кілт өзі жасалады.
SESSION_SECRET=

# Vercel Blob айнымалыларын (BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN) Vercel өзі қосады.
# Компьютерде олар болмаса, деректер ./.data қалтасында сақталады.

# Міндетті емес: SapaLine-дан тікелей алу үшін сервистік аккаунт (тек оқуға арналған SapaLine логині).
# Бос болса, «SapaLine-дан тікелей алу» бөлімі өшік тұрады да, бетбелгі әдісі жұмыс істей береді.
SAPALINE_EMAIL=
SAPALINE_PASSWORD=
# Міндетті емес: SapaLine қоймасының мекенжайы мен anon кілтін ауыстыру (әдетте керегі жоқ).
SAPALINE_URL=
SAPALINE_ANON_KEY=
